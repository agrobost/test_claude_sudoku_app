# Copier vers .env (non commité). Les EXPO_PUBLIC_* sont embarquées dans le binaire :
# n'y mettre QUE des identifiants publics by design (la sécurité serveur = RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phase 2 — monétisation & analytics (laisser vide tant que les comptes n'existent pas :
# l'app se dégrade proprement, sans pub ni tracking)
EXPO_PUBLIC_APPLOVIN_SDK_KEY=
EXPO_PUBLIC_MAX_BANNER_IOS=
EXPO_PUBLIC_MAX_BANNER_ANDROID=
EXPO_PUBLIC_MAX_INTERSTITIAL_IOS=
EXPO_PUBLIC_MAX_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_MAX_REWARDED_IOS=
EXPO_PUBLIC_MAX_REWARDED_ANDROID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# Menu debug (Réglages → Debug) hors dev build, ex. sur un build preview interne.
# Ne JAMAIS définir sur l'environnement production.
EXPO_PUBLIC_DEBUG_MENU=
